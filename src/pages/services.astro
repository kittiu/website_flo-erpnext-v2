---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';

const services = [
  {
    title: 'ERPNext Implementation',
    description: 'วางระบบ ERPNext แบบครบวงจร — เราศึกษากระบวนการธุรกิจของคุณจริง ๆ ก่อน กำหนดขอบเขตเป็นเอกสารชัดเจน (อะไรอยู่ในงาน อะไรไม่อยู่) แล้วส่งมอบเป็นระยะ: ออกแบบผังบัญชี ตั้งค่าระบบและภาษีไทย ย้ายข้อมูล ทดสอบ อบรม และดูแลหลัง go-live',
  },
  {
    title: 'Thai Localization',
    description: 'VAT, ภาษีหัก ณ ที่จ่าย, e-Tax Invoice/Receipt, รายงานภาษี และผังบัญชีที่ตรงกับวิธีปฏิบัติของไทย — ตั้งค่าโดยทีมที่เข้าใจทั้ง ERPNext และวิธีทำบัญชีของธุรกิจไทย ตั้งแต่ระยะออกแบบ ไม่ใช่แก้อีกรอบตอนปิดงบ',
  },
  {
    title: 'Data Migration',
    description: 'ย้าย master data (ลูกค้า supplier สินค้า พนักงาน) และยอดคงเหลือจาก Excel, Odoo, SAP หรือโปรแกรมบัญชีสำเร็จรูป พร้อมตรวจทานยอดกับงบทดลองก่อน go-live ทุกครั้ง เพื่อลดความเสี่ยงตัวเลขเพี้ยนตอนเปิดระบบ',
  },
  {
    title: 'Customization & Frappe Apps',
    description: 'เมื่อมาตรฐานของ ERPNext ไม่พอ เราปรับแต่งเป็น Frappe App ที่เป็นระเบียบ มีการทดสอบและจัดการเวอร์ชัน — ต่างจากวิธีแกะซอร์สหรือเขียน script ที่พออัปเกรดแล้วพัง งานที่ปรับแต่งไว้จะอยู่รอดทุกเวอร์ชันของ ERPNext',
  },
  {
    title: 'Integrations & API',
    description: 'เชื่อม ERPNext กับระบบรอบข้าง: e-Tax Invoice, ธนาคาร (นำเข้าใบ statement), Line, Shopify, e-commerce และระบบภายในองค์กร — ผ่าน REST API และ webhook ที่ ERPNext รองรับ ข้อมูลไหลถึงกันโดยไม่ต้องคีย์ซ้ำ',
  },
  {
    title: 'Training & Support / AMC',
    description: 'อบรมผู้ใช้ตามบทบาทจริง — ฝ่ายบัญชี ขาย สต็อก ผู้บริหาร — พร้อมคู่มือและข้อมูลตัวอย่าง ดูแล 30 วันหลัง go-live ต่อด้วยสัญญา AMC รายปี: อัปเดตเวอร์ชัน แก้ไขปัญหา และพัฒนาต่อยอดเมื่อธุรกิจโต',
  },
];

const icons = [
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />',
];
---

<BaseLayout title="Services" description={`ERPNext services by ${brand.name}: implementation, Thai localization, data migration, customization, integration, and training & support.`}>
  <Header slot="header" />

  <Banner title="ERPNext Services" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Services built around ERPNext</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          ERPNext ครอบคลุมการทำงานเกือบทุกด้านของธุรกิจอยู่แล้ว — งานของเราคือทำให้คุณได้ประโยชน์จากมันจริง ๆ
          ตั้งแต่การวางระบบไปจนถึงการดูแลระยะยาว
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {services.map((service, i) => (
          <div class="flex gap-5 rounded-lg border border-border bg-background p-6 shadow-sm">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i % icons.length]} />
            </div>
            <div>
              <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
              <p class="mt-2 text-text-muted leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
