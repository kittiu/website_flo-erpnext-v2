---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';

const principles = [
  {
    title: 'Configure before customize',
    description: 'ใช้ความสามารถมาตรฐานของ ERPNext ให้เต็มที่ก่อน แล้วค่อยปรับแต่งเฉพาะจุดที่จำเป็นจริง — ทำเป็น Frappe App ที่เป็นมาตรฐาน เพื่อให้อัปเกรดเวอร์ชันในอนาคตไม่พัง',
  },
  {
    title: 'Thai ready by design',
    description: 'ผังบัญชี VAT ภาษีหัก ณ ที่จ่าย และ e-Tax Invoice/Receipt ถูกวางตั้งแต่ระยะออกแบบ ตั้งค่าร่วมกับผู้ทำบัญชีของคุณตั้งแต่แรก ไม่ใช่แก้อีกรอบตอนปิดงบ',
  },
  {
    title: 'You own the system',
    description: 'ซอร์สโค้ด ข้อมูล และเซิร์ฟเวอร์เป็นของคุณ 100% เราอบรมทีมของคุณให้ดูแลระบบเองได้ หรือจะใช้บริการดูแลต่อเนื่องของเรา (AMC) ก็ได้ ไม่มีการ “ขัง” คุณไว้กับเรา',
  },
  {
    title: 'Success is real use',
    description: 'เราวัดความสำเร็จที่ทีมของคุณใช้ระบบจริง ข้อมูลถูกต้อง ปิดบัญชีทัน และธุรกิจเดินต่อได้ — ไม่ใช่แค่กดปุ่ม go-live แล้วจบ',
  },
];
---

<BaseLayout title="About Us" description={`Learn about ${brand.name} — our story, team, and commitment to quality service.`}>
  <Header slot="header" />

  <Banner title="About Flo Works" />

  <!-- Story -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=800&q=80"
          alt="ภาพตัวอย่าง — ทีมงานวางแผนโปรเจกต์วางระบบ ERP ร่วมกัน"
          width={800}
          height={600}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Our Story</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">15 years of ERP experience, one open-source belief</h2>
        <p class="text-text-muted leading-relaxed">
          ทีมของเราวางระบบ ERP ให้ธุรกิจไทยมากว่า 15 ปี — เริ่มจากระบบเปิดซอร์สรุ่นแรก ๆ อย่าง Adempiere และ Odoo
          ก่อนค้นพบว่า ERPNext คือคำตอบที่ลงตัวที่สุด: เปิดซอร์สเต็มรูปแบบ ครบทุกโมดูล และปรับแต่งได้
          โดยไม่ต้องผูกขาดกับผู้ขายรายใด
        </p>
        <p class="text-text-muted leading-relaxed">
          เราก่อตั้ง Flo Works Limited ด้วยความเชื่อว่า ธุรกิจไทยควรได้ ERP ระดับสากลในราคาที่เป็นธรรม —
          ไม่มีค่า license รายปี ไม่ถูกขังกับผู้ขาย และมีทีมที่เข้าใจทั้งเทคโนโลยีและบริบทภาษี-บัญชี-กระบวนการ
          ของไทยดูแลอย่างจริงจัง
        </p>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">How We Work</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">What we stand by on every project</h2>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {principles.map(({ title, description }) => (
          <div class="rounded-lg border border-border bg-background p-6 shadow-sm">
            <h3 class="font-heading text-h3 font-semibold text-text">{title}</h3>
            <p class="mt-2 leading-relaxed text-text-muted">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
